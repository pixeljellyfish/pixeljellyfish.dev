---
interface Props {
  name: string;
  href: string;
  icon: string;
  class?: string;
}

const { name, href, icon, class: className = "" } = Astro.props;
---

<a
  href={href}
  aria-label={name}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "inline-flex items-center justify-center size-16 rounded-lg",  // bigger square (48px)
    "transition-transform duration-200 ease-in-out",
    "hover:scale-110",
    "focus:outline-none",
    className
  ]}
>
  <img
    src={`/icons/${icon}.svg`}
    alt={`${name} icon`}
    class="w-8 h-8" 
  />
</a>